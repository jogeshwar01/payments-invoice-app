# For local cargo runs against docker-compose (which exposes host ports 7000/7001/7002).
DATABASE_URL=postgres://dodo:dodo@localhost:7000/dodo
PSP_BASE_URL=http://localhost:7001
BIND=0.0.0.0:8080
RUST_LOG=info,dodo_api=debug
PSP_TIMEOUT_MS=5000
RECONCILER_INTERVAL_MS=2000
RECONCILER_STALE_AFTER_MS=10000
DISPATCHER_INTERVAL_MS=2000
